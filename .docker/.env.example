# Copy to .docker/.env (or .docker/.env.prod) and fill in.
# The same keys become GitHub environment secrets via ./.docker/sync-env-secrets.sh.
# There is a single environment: prod, deployed from main.

# Host port the proxy is published on (the container always listens on 1435).
HTTP_PORT=1435
TZ=Asia/Bangkok

# ── Upstream LLM API (optional) ──
# Only used for models that are NOT chatgpt/*. Leave UPSTREAM_KEY empty if there
# is no second backend, or if it is a local one that needs no key.
UPSTREAM_URL=http://127.0.0.1:8080/v1
UPSTREAM_KEY=

# ── ChatGPT credentials ──
# Copied out of a logged-in chatgpt.com browser session; one line each, no quotes.
# CHATGPT_COOKIES: DevTools > Application > Cookies > https://chatgpt.com; must
# include __Secure-next-auth.session-token (HttpOnly, so document.cookie will not
# show it). If the cookie is chunked into .0/.1 parts, paste both.
CHATGPT_COOKIES=
# CHATGPT_ACCESS_TOKEN: DevTools > Network > any /backend-api/ request > Request
# Headers > authorization. An RS256 JWT good for ~10 days — rotating it is a
# secret update plus a redeploy.
CHATGPT_ACCESS_TOKEN=

# ── Optional ──
# Public base for the /files/ links returned with generated images. Must be the
# URL clients use to reach the proxy.
CHATGPT_FILES_BASE=http://127.0.0.1:1435
# 1 keeps every request in temporary-chat mode: nothing is stored on the account,
# at the cost of disabling image generation entirely.
CHATGPT_NEVER_STORE=0
