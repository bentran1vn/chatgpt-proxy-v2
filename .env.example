# ── Upstream LLM API (optional) ──
# Only used for models that are NOT chatgpt/*. Leave UPSTREAM_KEY empty if you
# have no second backend, or if it is a local one that needs no key.
UPSTREAM_URL=http://127.0.0.1:8080/v1
UPSTREAM_KEY=

# Port this proxy listens on
PORT=1435

# ── ChatGPT credentials ──
# Both are copied out of a logged-in chatgpt.com browser session. One line each,
# no quotes: the helper reads this file itself and does not strip them.

# DevTools > Application > Cookies > https://chatgpt.com
# Must include __Secure-next-auth.session-token (it is HttpOnly, so
# `document.cookie` in the Console will NOT show it). If the cookie is chunked
# into .0 / .1 suffixes, paste both parts.
CHATGPT_COOKIES=

# DevTools > Network > any /backend-api/ request > Request Headers >
# authorization. Paste the token with or without the leading "Bearer ".
# An RS256 JWT that lasts ~10 days; the helper reports the remaining time at
# startup and errors clearly once it lapses.
CHATGPT_ACCESS_TOKEN=

# ── Optional ──
# Base URL used when handing back links to generated images. Change it only if
# something other than this machine has to load them.
# CHATGPT_FILES_BASE=http://127.0.0.1:1435

# Set to 1 to keep every request in temporary-chat mode. Nothing is stored on
# the account, at the cost of disabling image generation entirely.
# CHATGPT_NEVER_STORE=0
